POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lexagent
POSTGRES_USER=lexagent
POSTGRES_PASSWORD=lexagent_secret

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=eu_ai_act
QDRANT_API_KEY=

GOOGLE_API_KEY=

# Optional: route the classifier node through the local QLoRA fine-tuned
# model instead of Gemini. No API key needed for this path. See
# finetune/README.md for how it was trained and evaluated.
USE_LOCAL_CLASSIFIER=false

LOG_LEVEL=INFO
ENVIRONMENT=development
